{
  "root": true,
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["../../biome.base.json"],
  "files": {
    "includes": ["!**/dist"]
  },
  "formatter": {
    "includes": ["**", "!**/*.md", "!**/dist", "!**/src/gen"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noControlCharactersInRegex": "off"
      }
    }
  }
}

{
  "root": true,
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["../../biome.base.json"],
  "files": {
    "includes": ["!**/dist", "!**/src/gen"]
  },
  "formatter": {
    "includes": ["**", "!**/dist/**", "!**/src/gen/**"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noControlCharactersInRegex": "off"
      }
    }
  }
}
